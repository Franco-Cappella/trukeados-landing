# URL del juego. Todos los botones "Jugar" la usan. Sin definir: https://game.trukeados.com en el build y
# http://localhost:8787 con npm run dev.
VITE_GAME_URL=https://game.trukeados.com

# URL pública de la landing, con barra al final (por ejemplo https://trukeados.com.ar/). La usan la imagen de
# Open Graph y la canónica, que tienen que ser absolutas. Sin definir, el build usa https://trukeados.com/.
VITE_SITE_URL=https://trukeados.com/

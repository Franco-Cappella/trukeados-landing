{
  // Landing de Trukeados: solo archivos estáticos (el build de Vite en dist/), sin código de servidor.
  // Cloudflare construye con `npm run build` y publica con `npx wrangler deploy`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trukeados-landing",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist"
  }
}
